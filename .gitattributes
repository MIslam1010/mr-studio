# Normalise line endings in the repository; checkouts use the platform default
* text=auto
# Keep Unix line endings for shell scripts on every platform (bash fails on CRLF)
*.sh text eol=lf
*.command text eol=lf
# Windows scripts and the Inno Setup script use CRLF
*.ps1 text eol=crlf
*.iss text eol=crlf
*.png binary
